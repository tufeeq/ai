ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Use only a feed entitled to the account. No silent fallback.
TAGIT_DATA_FEED=iex
TAGIT_ALLOWED_ORIGIN=https://tufeeq.github.io
# Opt-in only on an always-on host with a writable persistent volume:
TAGIT_BACKGROUND=0
TAGIT_STREAM=0
TAGIT_STREAM_SYMBOL_LIMIT=30
TAGIT_JOURNAL_PATH=
# Full path to Python 3.12+; paper.py uses only the standard library.
TAGIT_PAPER_PYTHON=
# JSON file of dated, sourced round-lot sizes. Unknown sizes block paper fills.
TAGIT_LOT_METADATA=
# Optional live Zoya key; sandbox keys never produce compliance ratings.
ZOYA_API_KEY=
# Set only after the provider grants the required public display permission.
TAGIT_SHARIA_PUBLIC_DISPLAY=0
