# Keep the image small and free of secrets.
# Runtime needs only: package.json, server.mjs, src/, public/,
# projects.json and knowledge/index.json.

# Secrets and local state
.env
.env.*
!.env.example
data/
*.key
*.log

# Tests, tooling and client samples (not used at runtime)
tests/
scripts/
clients/
coverage/
node_modules/

# Docs
*.md
**/*.md

# Knowledge builder is a build-time tool; only the generated index ships
knowledge/*
!knowledge/index.json

# Container and VCS files
Dockerfile
docker-compose.yml
docker-compose*.yml
.dockerignore
.git
.gitignore
.github/
.vscode/
.idea/
.DS_Store
