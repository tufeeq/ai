# AI Hub — environment variables.
# Local:   cp .env.example .env   (the .env file is git-ignored; never commit it)
# Dokploy: paste these lines into the app's Environment tab.
# Every value below is a safe default or a placeholder — no real secrets here.

# --- Model -------------------------------------------------------------------
# Ollama model tag used by default for chat, the OpenAI gateway and TAGit.
AI_MODEL=gemma3:4b
# Context window in tokens. Larger = more RAM and slower on CPU.
AI_NUM_CTX=4096
# Max time for one model call in milliseconds (CPU inference is slow).
LLM_TIMEOUT_MS=180000
# Pull AI_MODEL automatically on first boot (true/false).
AUTO_PULL_MODEL=true
# Where the hub reaches Ollama. Keep the default inside this compose stack.
OLLAMA_URL=http://ollama:11434

# --- Security ----------------------------------------------------------------
# Admin key for /admin and key management. Use a long random value, e.g.
#   openssl rand -base64 32
# Leave empty to let the hub generate one (printed once in the hub logs and
# stored in the data volume as admin.key).
ADMIN_KEY=
# Requests per minute allowed per API key (or per IP).
RATE_LIMIT_RPM=60
# Largest accepted request body in bytes.
MAX_BODY_BYTES=1000000

# --- "Estimated savings" reference prices (display only, not billing) ---------
# USD per 1M input tokens of the paid API you are comparing against.
REF_PRICE_IN_PER_M=2.5
# USD per 1M output tokens of the paid API you are comparing against.
REF_PRICE_OUT_PER_M=10

# --- Ollama tuning (CPU-only VPS) --------------------------------------------
# How long a model stays loaded in RAM after the last request.
OLLAMA_KEEP_ALIVE=30m
# Parallel requests per model. Keep 1 on CPU.
OLLAMA_NUM_PARALLEL=1
# Models kept in RAM at the same time. Keep 1 on a small VPS.
OLLAMA_MAX_LOADED_MODELS=1

# --- Set by docker-compose.yml / Dockerfile (only needed when running the
# --- server directly with `node server.mjs`, outside Docker) ------------------
# HTTP port the hub listens on.
# PORT=8080
# Folder for keys, usage log and the generated admin key.
# DATA_DIR=./data
# Override the knowledge index location (default: knowledge/index.json).
# KNOWLEDGE_PATH=
# Override the projects file location (default: projects.json).
# PROJECTS_PATH=

# Resource caps on a shared server (the model container is restarted alone if it exceeds its cap).
OLLAMA_MEM_LIMIT=6g
OLLAMA_CPUS=4
HUB_MEM_LIMIT=512m
