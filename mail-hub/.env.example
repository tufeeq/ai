# ---- Mail Hub settings (Dokploy → Environment) ----

# Public name of the mail server. Must have an A record to this server and the PTR (reverse DNS) set to it.
MAIL_HOST=mail.tryn.cc

# Mailbox the mailer service sends from (create it in Stalwart first, see DEPLOY.md step 5).
MAILER_SMTP_USER=no-reply@tryn.cc
MAILER_SMTP_PASS=

# Optional. Empty = the mailer generates its admin key on first boot and prints it once in its logs.
MAILER_ADMIN_KEY=

# Optional tuning
# RESET_TTL_MINUTES=30
# PROJECT_RPM=60
# SEND_PER_HOUR=300
# TZ=Asia/Riyadh
# STALWART_SETUP_BIND=127.0.0.1:18080   # set to 0.0.0.0:18080 only while running the setup wizard
# TRAEFIK_ACME_JSON=/etc/dokploy/traefik/dynamic/acme.json
