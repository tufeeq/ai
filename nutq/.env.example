# Translation — AI Hub (or any OpenAI-compatible service)
AI_BASE_URL=https://ai.tryn.cc/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=180000

# Voices — Azure AI Speech (key + region of your Speech resource)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional instead of region, e.g. https://<name>.cognitiveservices.azure.com
AZURE_SPEECH_ENDPOINT=
DEFAULT_VOICE=ar-SA-HamedNeural

# Limits (per visitor IP, per minute)
MAX_INPUT_CHARS=200
TRANSLATE_RPM=10
AUDIO_RPM=60
