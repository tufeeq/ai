{
  "referenceVersion": "TAG5",
  "policyVersion": "2026-08-11.4",
  "finalSnapshotReconciliation": {
    "required": true,
    "minimumIndependentSourcesWhenPossible": 2,
    "singleSourceFinalMoverAccepted": false,
    "materialDisagreementState": "DATA_INTEGRITY_ERROR",
    "trainingBlockedUntilResolved": true
  },
  "snapshotTiming": {
    "storeTimestampUTC": true,
    "storeTimestampET": true,
    "distinguishIntraperiodFromFinal": true,
    "preMarketHourlyBuckets": ["PM1", "PM2", "PM3", "PM4", "PM5", "PM6"],
    "afterHoursHourlyBuckets": ["AH1", "AH2", "AH3", "AH4"],
    "requireContiguousBucketsForPersistence": true,
    "cadenceComparisonMustStayWithinSameTradingDate": true,
    "newTradingDateResetsCadenceState": true,
    "preserveEarliestObservedTimestampAcrossTradingDate": true,
    "preserveSeparateEarliestObservedTimestampWithinSession": true,
    "crossSessionTransitionMustNotResetFirstObserved": true,
    "preserveEarliestObservedChangeAndVolume": true,
    "latestBucketReplacementMustNotEraseFirstObservation": true,
    "firstObservedTimestampIsNotEquivalentToFirstActionableSignal": true
  },
  "dataFreshness": {
    "liveSnapshotMaxAgeMinutes": 20,
    "staleState": "STALE_DATA_ERROR",
    "staleSnapshotTrainingEligible": false,
    "staleSnapshotRealtimeClaimEligible": false
  },
  "modelInputIntegrity": {
    "required": true,
    "liveModelMustReceivePipelinePersistenceMetadata": true,
    "liveModelMustReceiveSnapshotIntegrityMetadata": true,
    "missingMandatoryCatalystOrExtendedHoursInputsState": "INCOMPLETE_MODEL_INPUTS",
    "incompleteInputsCannotCreateFirstActionableSignal": true,
    "rawAppearanceCannotSubstituteForModelQualification": true,
    "uiMustDistinguishFreshReconciledFromFreshUnreconciledAndStale": true
  },
  "classification": {
    "phases": ["DISCOVERY", "IGNITION", "LATE", "EXHAUSTION"],
    "hugeRvolAfterStrongPriceExpansionCannotQualifyAsEarlyDiscoveryByItself": true,
    "mandatoryFreshCatalystSweepBeforeNoNewsPath": true,
    "catalystAttributionErrorTrackedSeparately": true,
    "exhaustionMemoryPenaltyRequired": true
  },
  "validation": {
    "multiSessionRequiredForVersionUpgrade": true,
    "separateMarketDataClassificationErrors": true,
    "recordMissedMovers": true,
    "recordFalsePositives": true,
    "recordFirstObservedTimestamp": true,
    "recordFirstSessionObservedTimestamp": true,
    "recordFirstActionableSignalTimestamp": true,
    "actionableTimestampRequiresModelQualificationNotRawAppearance": true,
    "doNotClaimUnverifiedPredictionSuccess": true
  },
  "sharia": {
    "excludeCoreProhibitedActivities": true,
    "financiallyUnverifiedState": "UNVERIFIED"
  }
}