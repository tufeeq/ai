{
  "referenceVersion": "TAG5",
  "policyVersion": "2026-08-13.2",
  "finalSnapshotReconciliation": {
    "required": true,
    "minimumIndependentSourcesWhenPossible": 2,
    "singleSourceFinalMoverAccepted": false,
    "materialDisagreementState": "DATA_INTEGRITY_ERROR",
    "trainingBlockedUntilResolved": true,
    "fieldLevelEligibility": true,
    "priceChangeOutcomeMayTrainWhenIndependentlyReconciled": true,
    "volumeDerivedMetricsRequireIndependentFinalVolumeReconciliation": true,
    "singleSessionReconciliationCannotTriggerVersionPromotion": true
  },
  "snapshotTiming": {
    "storeTimestampUTC": true,
    "storeTimestampET": true,
    "distinguishIntraperiodFromFinal": true,
    "preMarketHourlyBuckets": ["PM1", "PM2", "PM3", "PM4", "PM5", "PM6"],
    "afterHoursHourlyBuckets": ["AH1", "AH2", "AH3", "AH4"],
    "requireContiguousBucketsForPersistence": true,
    "sessionCadenceMaxGapMinutes": 15,
    "cadenceGapState": "SESSION_CADENCE_GAP",
    "cadenceGapBlocksPersistenceTraining": true,
    "cadenceComparisonMustStayWithinSameTradingDate": true,
    "newTradingDateResetsCadenceState": true,
    "preserveEarliestObservedTimestampAcrossTradingDate": true,
    "preserveSeparateEarliestObservedTimestampWithinSession": true,
    "crossSessionTransitionMustNotResetFirstObserved": true,
    "preserveEarliestObservedChangeAndVolume": true,
    "latestBucketReplacementMustNotEraseFirstObservation": true,
    "firstObservedTimestampIsNotEquivalentToFirstActionableSignal": true
  },
  "ingestionReliability": {
    "nominalRefreshMinutes": 5,
    "primaryScheduler": "GITHUB_ACTIONS_SCHEDULE",
    "cadenceKeeperEnabled": true,
    "cadenceKeeperStrategy": "LONG_RUNNING_INTERNAL_5_MINUTE_DISPATCH_LOOP",
    "cadenceKeeperWindowET": "04:00-20:00_WEEKDAYS",
    "schedulerDelayMustNotBeInterpretedAsMarketInactivity": true,
    "missingRefreshCreatesDataIntegrityGap": true,
    "rankingMustFailClosedWhenFreshnessLimitExceeded": true
  },
  "dataFreshness": {
    "liveSnapshotMaxAgeMinutes": 15,
    "staleState": "STALE_DATA_ERROR",
    "staleSnapshotTrainingEligible": false,
    "staleSnapshotRealtimeClaimEligible": false,
    "staleSnapshotRankingEligible": false
  },
  "extendedHoursFieldIntegrity": {
    "required": true,
    "pipelineEnforced": true,
    "doNotAssumeRegularSessionChangeOrVolumeAreExtendedHoursNative": true,
    "crossBucketFreezeTestRequired": true,
    "freezeTestFields": ["Change", "Volume"],
    "freezeThreshold": 0.8,
    "minimumCommonTickers": 10,
    "changeEqualityTolerancePctPoints": 0.01,
    "volumeRelativeEqualityTolerance": 0.001,
    "freezeState": "SOURCE_FIELD_FREEZE_SUSPECTED",
    "unverifiedState": "UNVERIFIED_EXTENDED_HOURS_FIELDS",
    "blockedMetrics": ["Persistence Slope", "Hour-to-Hour Gain Retention", "After-Hours Volume Participation", "Extended-Hours Volume Takeover"],
    "blockedMetricsCannotTrainOrCreateActionableSignal": true,
    "requireExtendedHoursNativeSourceBeforeReenable": true
  },
  "modelInputIntegrity": {
    "required": true,
    "liveModelMustReceivePipelinePersistenceMetadata": true,
    "liveModelMustReceiveSnapshotIntegrityMetadata": true,
    "missingMandatoryCatalystOrExtendedHoursInputsState": "INCOMPLETE_MODEL_INPUTS",
    "incompleteInputsCannotCreateFirstActionableSignal": true,
    "rawAppearanceCannotSubstituteForModelQualification": true,
    "uiMustDistinguishFreshReconciledFromFreshUnreconciledAndStale": true
  },
  "actionableSignalInstrumentation": {
    "required": true,
    "nullTimestampMustHaveExplicitReason": true,
    "validNullReasons": ["NOT_MODEL_QUALIFIED", "INCOMPLETE_MODEL_INPUTS", "DATA_INTEGRITY_BLOCK", "SHARIA_UNVERIFIED", "SHARIA_EXCLUDED", "NOT_EVALUATED"],
    "pipelineMustPersistQualificationDecision": true,
    "pipelineMustPersistDecisionTimestampET": true,
    "pipelineMustPersistDecisionPhase": true,
    "pipelineMustPersistDecisionScore": true,
    "pipelineMustPersistDecisionReasonCodes": true,
    "blockedCasesMustStillPersistExplicitDecisionRecord": true,
    "missingCatalystSweepMustBeRecordedAsIncompleteModelInput": true,
    "missingShariaVerificationMustBeRecordedAsIncompleteModelInput": true,
    "blockedCaseCannotBeCountedAsFalsePositiveOrMissedMoverUntilFullyEvaluated": true,
    "missedMoverMetricsBlockedIfInstrumentationMissing": true,
    "falsePositiveMetricsBlockedIfInstrumentationMissing": true,
    "earlyDetectionClaimsBlockedIfInstrumentationMissing": true,
    "missingInstrumentationState": "ACTIONABILITY_INSTRUMENTATION_ERROR"
  },
  "classification": {
    "phases": ["DISCOVERY", "IGNITION", "LATE", "EXHAUSTION"],
    "hugeRvolAfterStrongPriceExpansionCannotQualifyAsEarlyDiscoveryByItself": true,
    "mandatoryFreshCatalystSweepBeforeNoNewsPath": true,
    "catalystAttributionErrorTrackedSeparately": true,
    "exhaustionMemoryPenaltyRequired": true
  },
  "validation": {
    "multiSessionRequiredForVersionUpgrade": true,
    "separateMarketDataClassificationErrors": true,
    "recordMissedMovers": true,
    "recordFalsePositives": true,
    "recordFirstObservedTimestamp": true,
    "recordFirstSessionObservedTimestamp": true,
    "recordFirstActionableSignalTimestamp": true,
    "actionableTimestampRequiresModelQualificationNotRawAppearance": true,
    "doNotClaimUnverifiedPredictionSuccess": true,
    "blockPerformanceMetricsWhenActionabilityInstrumentationMissing": true,
    "allowOutcomeLabelLearningOnlyFromReconciledPriceChange": true,
    "blockVolumeThresholdLearningUnlessVolumeReconciled": true
  },
  "sharia": {
    "excludeCoreProhibitedActivities": true,
    "financiallyUnverifiedState": "UNVERIFIED"
  }
}